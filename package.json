{
  "name": "workout-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for workout tracking and guidance",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node --inspect=9230 dist/index.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "packageManager": "pnpm@10.17.0",
  "keywords": [
    "mcp",
    "workout",
    "fitness",
    "tracking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "drizzle-orm": "^0.44.5",
    "better-sqlite3": "^12.2.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/jest": "^29.5.8",
    "@types/better-sqlite3": "^7.6.8",
    "typescript": "^5.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.3",
    "drizzle-kit": "^0.28.0"
  }
}
